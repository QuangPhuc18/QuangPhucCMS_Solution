@model CMS_DATA.Entities.Banner

@{
    ViewData["Title"] = "Tạo Mới Banner";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.0/font/bootstrap-icons.css">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="card-header bg-dark text-white p-4 border-0 d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="mb-1 fw-bold text-uppercase tracking-wide">
                            <i class="bi bi-image-fill me-2 text-warning"></i> Thêm Banner Mới
                        </h4>
                        <p class="mb-0 text-white-50 small">Tải ảnh từ máy tính lên để hiển thị ngoài trang chủ DigiHome</p>
                    </div>
                    <a asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-3">
                        <i class="bi bi-arrow-left"></i> Danh sách
                    </a>
                </div>

                <div class="card-body p-5 bg-white">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">

                        <div class="row g-4">
                            <div class="col-md-5 border-end pe-md-4">
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-secondary">Hình ảnh Banner <span class="text-danger">*</span></label>
                                    <div class="card bg-light border-2 border-dashed rounded-3 p-3 text-center position-relative hover:border-primary transition" style="min-height: 200px; justify-content: center; align-items: center;">

                                        <input type="file" name="imageFile" id="imageInput" class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer" accept="image/*" required />

                                        <div id="previewContainer" class="d-none w-100">
                                            <img id="imagePreview" src="#" alt="Preview" class="img-fluid rounded-3 shadow-sm" style="max-height: 180px; object-fit: cover;" />
                                            <p class="text-primary small mt-2 mb-0 fw-semibold"><i class="bi bi-arrow-repeat"></i> Click để chọn ảnh khác</p>
                                        </div>

                                        <div id="uploadPlaceholder" class="py-3">
                                            <i class="bi bi-folder-plus text-secondary display-5"></i>
                                            <p class="fw-bold text-muted mt-2 mb-1 small">Bấm vào đây để chọn file</p>
                                            <span class="text-black-50 small" style="font-size: 11px;">Hỗ trợ: JPG, PNG, WEBP</span>
                                        </div>
                                    </div>
                                    <span class="text-danger small mt-1 d-block">@Html.ValidationMessage("imageFile")</span>
                                </div>
                            </div>

                            <div class="col-md-7 ps-md-4">
                                <div class="mb-3">
                                    <label asp-for="Title" class="form-label fw-bold text-secondary">Tiêu đề chính <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-type-h1"></i></span>
                                        <input asp-for="Title" class="form-control bg-light" placeholder="Ví dụ: ĐẠI TIỆC SIÊU SALE" required />
                                    </div>
                                    <div asp-validation-summary="All" class="text-danger small"></div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Subtitle" class="form-label fw-bold text-secondary">Tiêu đề phụ</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="bi bi-chat-left-text"></i></span>
                                        <input asp-for="Subtitle" class="form-control bg-light" placeholder="Ví dụ: Siêu sale hôm nay giảm giá kịch sàn" />
                                    </div>
                                    <span asp-validation-for="Subtitle" class="text-danger small"></span>
                                </div>

                                <div class="row align-items-center mt-4">
                                    <div class="col-sm-6">
                                        <label asp-for="DisplayOrder" class="form-label fw-bold text-secondary">Thứ tự hiển thị</label>
                                        <input asp-for="DisplayOrder" class="form-control bg-light" type="number" value="0" min="0" />
                                    </div>
                                    <div class="col-sm-6 pt-3 pt-sm-0">
                                        <div class="form-check form-switch card p-2 bg-light border-0 m-0 shadow-sm flex-row justify-content-between align-items-center px-3" style="height: 38px;">
                                            <label class="form-check-label fw-bold text-success small cursor-pointer" for="IsActive">HIỂN THỊ LUÔN</label>
                                            <input class="form-check-input mt-0 cursor-pointer" type="checkbox" asp-for="IsActive" checked />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 text-black-50 opacity-10" />

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 fw-bold">Hủy bỏ</a>
                            <button type="submit" class="btn btn-dark text-warning rounded-3 px-5 fw-bold shadow">
                                <i class="bi bi-cloud-upload-fill me-1"></i> Tải Lên & Lưu
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('imageInput').addEventListener('change', function(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imagePreview').src = e.target.result;
                document.getElementById('previewContainer').classList.remove('d-none');
                document.getElementById('uploadPlaceholder').classList.add('d-none');
            }
            reader.readAsDataURL(file);
        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}